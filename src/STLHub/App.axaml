<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STLHub.App"
             xmlns:local="using:STLHub"
             xmlns:sty="using:Avalonia.Styling"
             RequestedThemeVariant="Dark">

    <!-- macOS application menu (the bold "STLHub" menu next to the Apple menu). -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Sobre o STLHub" Click="OnAboutMenuClicked"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <!-- Fluent's own accent (checkbox, focused fields, list selection) follows the theme's
             AccentColor instead of the operating system's blue. Fluent only accepts Dark and
             Light palettes; App.ApplyTheme re-points the matching one when a skin (Nord,
             Dracula, Solarized) is selected. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#E8922A"/>
                <ColorPaletteResources x:Key="Light" Accent="#C07320"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Every window (dialogs included) sits on the warm canvas, not Fluent's grey; the
             darker canvas also lets secondary buttons read as buttons inside dialogs. -->
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource ContentBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- ═══════════ BUTTONS ═══════════
             One button system for the whole app. Buttons never set their own colors; they pick
             a variant class. These styles target Fluent's template part so hover / pressed /
             disabled keep the variant instead of falling back to Fluent's cool grey.
               (none)   secondary: warm tool-handle fill   "Fechar", "Anexar Arquivo..."
               primary  the one amber action of a region   "Abrir", "Salvar Alterações"
               danger   confirms a destructive action      "Excluir"
               ghost    icon-only, transparent at rest     ⓘ, clear search, ✕
               overlay  sits on a thumbnail/image          attachment ✕
             ("primary", not "accent": Fluent ships its own Button.accent in system blue.)
             Two heights only: 32px (MinHeight) for every text button, 36px for "Salvar".
             Focus is a 2px inner ring drawn by the button's own border, so it never shifts
             layout and always follows the corner radius. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <!-- The fill runs under the transparent border, so a 32px button shows 32px of fill. -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BackgroundSizing" Value="OuterBorderEdge"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnHoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnHoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <!-- An amber ring would vanish on the amber fill; filled buttons ring in TextPrimary,
             which stands out against the surface around them in every theme. -->
        <Style Selector="Button.primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDanger}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerHoverColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDanger}"/>
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDanger}"/>
        </Style>
        <Style Selector="Button.danger:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
        </Style>
        <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnHoverBg}"/>
        </Style>
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.overlay">
            <Setter Property="Background" Value="{DynamicResource BadgeBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BadgeText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.overlay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnDanger}"/>
        </Style>
        <!-- Stroked glyphs inside an overlay button follow its state. -->
        <Style Selector="Button.overlay Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource BadgeText}"/>
        </Style>
        <Style Selector="Button.overlay:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource TextOnDanger}"/>
        </Style>

        <!-- ═══════════ FOCUS FOR OTHER CONTROLS ═══════════
             Fluent's white focus square is replaced everywhere by a border the control already
             draws, so focus follows the control's shape. Each control keeps a transparent 2px
             border at rest, so gaining focus never shifts layout. -->
        <Style Selector="ComboBox, CheckBox, TextBox, RadioButton, ListBoxItem, TreeViewItem">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="CheckBox:checked:focus-visible /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>

        <!-- row: full-width sidebar entry ("Todos os Objetos", "Nova Categoria"). Uses the
             SidebarRowButton template in MainWindow; draws its own inset focus border. -->
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
        </Style>
        <Style Selector="Button.row.active">
            <Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.row:focus-visible /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══════════ ICONS ═══════════
                 One family: solid 16×16 shapes, even-odd cut-outs for detail, used through
                 PathIcon so they take the surrounding text color. No emoji as icons. -->
            <StreamGeometry x:Key="IconModel">M8 1l6.5 3.5L8 8 1.5 4.5z M1 5.6l6.4 3.4V15L1 11.6z M8.6 9L15 5.6v6L8.6 15z</StreamGeometry>
            <StreamGeometry x:Key="IconTag">M1 1h6.6L15 8.4 8.4 15 1 7.6V1zm3.25 2a1.25 1.25 0 100 2.5 1.25 1.25 0 000-2.5z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M1 3.5A1.5 1.5 0 012.5 2h3.6l1.6 1.6h5.8A1.5 1.5 0 0115 5.1v7.4a1.5 1.5 0 01-1.5 1.5h-11A1.5 1.5 0 011 12.5z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderOpen">M1 3.5A1.5 1.5 0 012.5 2h3.6l1.6 1.6h4.8A1.5 1.5 0 0114 5.1V6H5.2a1.5 1.5 0 00-1.4 1L1.6 13.3A1.5 1.5 0 011 12.1z M5.6 7.2h9.3a.7.7 0 01.66.92l-1.9 5.4a.7.7 0 01-.66.48H2.4z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderPlus">M1 3.5A1.5 1.5 0 012.5 2h3.6l1.6 1.6h5.8A1.5 1.5 0 0115 5.1v7.4a1.5 1.5 0 01-1.5 1.5h-11A1.5 1.5 0 011 12.5z M7.25 6.25h1.5V8h1.75v1.5H8.75v1.75h-1.5V9.5H5.5V8h1.75z</StreamGeometry>
            <StreamGeometry x:Key="IconPencil">M11.5 1l3.5 3.5L5.5 14H2v-3.5z M9.65 3.55l2.8 2.8-.7.7-2.8-2.8z</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M5.5 1h5v1.5H14V4H2V2.5h3.5z M3 5h10l-.8 10H3.8z M6 7v6h1.2V7z M8.8 7v6H10V7z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M6.3 13.2L1.6 8.5l1.8-1.8 2.9 2.9 6.3-6.3 1.8 1.8z</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M13.2 5A6 6 0 1 1 9.04 2.09L8.76 3.67A4.4 4.4 0 1 0 11.81 5.8z M9.22 1.11L12.06 3.32 8.63 4.45z</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M8 1l7.5 13.5H.5z M7.2 5.5h1.6v4.7H7.2z M7.2 11.3h1.6v1.6H7.2z</StreamGeometry>
            <StreamGeometry x:Key="IconFile">M3 1h6v4h4v10H3z M10 1l3 3h-3z</StreamGeometry>
            <StreamGeometry x:Key="IconDocument">M3 1h6v4h4v10H3z M10 1l3 3h-3z M5 7.5h6v1.2H5z M5 10h6v1.2H5z M5 12.5h4v1.2H5z</StreamGeometry>
            <StreamGeometry x:Key="IconImage">M1 2h14v12H1z M2.5 3.5v9h11v-9z M3.5 11.5l3-4 2 2.5 1.5-1.5 2.5 3z M10.5 4.8a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z</StreamGeometry>
            <StreamGeometry x:Key="IconArchive">M2 1h12v14H2z M7 2h2v1.2H7z M7 4.2h2v1.2H7z M7 6.4h2v1.2H7z M6.5 8.6h3v4h-3z</StreamGeometry>
            <StreamGeometry x:Key="IconVideo">M1 3h10v10H1z M11.5 6.5L15 4.5v7l-3.5-2z</StreamGeometry>
            <StreamGeometry x:Key="IconAudio">M6 2.2L14 1v10a2.4 2.4 0 11-1.6-2.26V3.6L7.6 4.4V12.5a2.4 2.4 0 11-1.6-2.26z</StreamGeometry>
            <StreamGeometry x:Key="IconCode">M5.5 3L1 8l4.5 5 1.2-1.1L3.2 8l3.5-3.9z M10.5 3L15 8l-4.5 5-1.2-1.1L12.8 8 9.3 4.1z</StreamGeometry>
            <StreamGeometry x:Key="IconPrinter">M5 1h6v3H5z M3.5 5h9v4h-9z M6.5 10h3L8 13z M2 14.3h12v1.2H2z</StreamGeometry>

            <!-- ═══════════ FLUENT CONTROLS ON WARM TOKENS ═══════════
                 Fluent's text field, combo box and check box brushes, re-pointed at the theme
                 tokens so no control falls back to cool grey, pure black or system blue. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource ContentBg}"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource ContentBg}"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource ContentBg}"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource TextMuted}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource AccentColor}"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource TextSecondary}"/>

            <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource ToolbarBtnBg}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource ToolbarBtnHoverBg}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource ToolbarBtnHoverBg}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource ToolbarBtnBg}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource ToolbarBtnBg}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource ToolbarBg}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource SeparatorColor}"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource SidebarHoverBg}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{DynamicResource SidebarActiveBg}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource SidebarActiveBg}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource SidebarActiveBg}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{DynamicResource SidebarActiveBg}"/>

            <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource ToolbarBg}"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource SeparatorColor}"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource ToolbarBg}"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource SeparatorColor}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource SidebarHoverBg}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource SidebarActiveBg}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{DynamicResource SeparatorColor}"/>

            <!-- The checked CheckBox fills with the theme accent; its check mark takes the
                 accent's label color instead of Fluent's fixed white. -->
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource TextOnAccent}"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource TextOnAccent}"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource TextOnAccent}"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource TextSecondary}"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{DynamicResource TextPrimary}"/>
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{DynamicResource TextPrimary}"/>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ═══════════ DARK THEME ═══════════ -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ToolbarBg">#1E1B18</Color>
                    <Color x:Key="SidebarBg">#171410</Color>
                    <Color x:Key="SidebarHeaderBg">#1E1B18</Color>
                    <Color x:Key="SidebarHoverBg">#2B2620</Color>
                    <Color x:Key="SidebarActiveBg">#38302A</Color>
                    <Color x:Key="ContentBg">#141210</Color>
                    <Color x:Key="DetailsBg">#1E1B18</Color>
                    <Color x:Key="CardBg">#252019</Color>
                    <Color x:Key="CardThumbnailBg">#302820</Color>
                    <Color x:Key="TagBg">#3A2E1C</Color>
                    <Color x:Key="AccentColor">#E8922A</Color>
                    <Color x:Key="AccentHoverColor">#F0A040</Color>
                    <Color x:Key="ToolbarBtnBg">#2B2620</Color>
                    <Color x:Key="ToolbarBtnHoverBg">#38302A</Color>
                    <Color x:Key="TextPrimary">#EDE8E2</Color>
                    <Color x:Key="TextSecondary">#A09890</Color>
                    <Color x:Key="TextMuted">#605850</Color>
                    <Color x:Key="TextOnAccent">#1C1710</Color>
                    <Color x:Key="SeparatorColor">#2B2620</Color>
                    <Color x:Key="BadgeBg">#CC141210</Color>
                    <Color x:Key="BadgeText">#C8C0B8</Color>
                    <Color x:Key="DangerColor">#C84040</Color>
                    <Color x:Key="DangerHoverColor">#B53636</Color>
                    <Color x:Key="TextOnDanger">#FFF8F0</Color>
                    <Color x:Key="EditBorderColor">#E8922A</Color>
                    <Color x:Key="EditBg">#302820</Color>
                </ResourceDictionary>

                <!-- ═══════════ LIGHT THEME ═══════════ -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ToolbarBg">#EFEBE5</Color>
                    <Color x:Key="SidebarBg">#F5F1EC</Color>
                    <Color x:Key="SidebarHeaderBg">#EFEBE5</Color>
                    <Color x:Key="SidebarHoverBg">#E8E2DB</Color>
                    <Color x:Key="SidebarActiveBg">#DDD5CC</Color>
                    <Color x:Key="ContentBg">#FAF8F4</Color>
                    <Color x:Key="DetailsBg">#EFEBE5</Color>
                    <Color x:Key="CardBg">#FEFCF9</Color>
                    <Color x:Key="CardThumbnailBg">#EAE4DC</Color>
                    <Color x:Key="TagBg">#FAEEDD</Color>
                    <Color x:Key="AccentColor">#C07320</Color>
                    <Color x:Key="AccentHoverColor">#D17D23</Color>
                    <Color x:Key="ToolbarBtnBg">#E0D8D0</Color>
                    <Color x:Key="ToolbarBtnHoverBg">#D4CAC0</Color>
                    <Color x:Key="TextPrimary">#1C1810</Color>
                    <Color x:Key="TextSecondary">#5A5248</Color>
                    <Color x:Key="TextMuted">#A09888</Color>
                    <Color x:Key="TextOnAccent">#1C1810</Color>
                    <Color x:Key="SeparatorColor">#D8D0C8</Color>
                    <Color x:Key="BadgeBg">#CC1C1810</Color>
                    <Color x:Key="BadgeText">#F0EBE4</Color>
                    <Color x:Key="DangerColor">#C83030</Color>
                    <Color x:Key="DangerHoverColor">#B02828</Color>
                    <Color x:Key="TextOnDanger">#FFFFFF</Color>
                    <Color x:Key="EditBorderColor">#C07320</Color>
                    <Color x:Key="EditBg">#FEFCF9</Color>
                </ResourceDictionary>

                <!-- ═══════════ NORD THEME ═══════════ -->
                <ResourceDictionary x:Key="{x:Static local:AppThemes.Nord}">
                    <Color x:Key="ToolbarBg">#3B4252</Color>
                    <Color x:Key="SidebarBg">#2E3440</Color>
                    <Color x:Key="SidebarHeaderBg">#3B4252</Color>
                    <Color x:Key="SidebarHoverBg">#434C5E</Color>
                    <Color x:Key="SidebarActiveBg">#4C566A</Color>
                    <Color x:Key="ContentBg">#2E3440</Color>
                    <Color x:Key="DetailsBg">#3B4252</Color>
                    <Color x:Key="CardBg">#3B4252</Color>
                    <Color x:Key="CardThumbnailBg">#434C5E</Color>
                    <Color x:Key="TagBg">#4C566A</Color>
                    <Color x:Key="AccentColor">#5477A2</Color>
                    <Color x:Key="AccentHoverColor">#4D6D95</Color>
                    <Color x:Key="ToolbarBtnBg">#434C5E</Color>
                    <Color x:Key="ToolbarBtnHoverBg">#4C566A</Color>
                    <Color x:Key="TextPrimary">#ECEFF4</Color>
                    <Color x:Key="TextSecondary">#D8DEE9</Color>
                    <Color x:Key="TextMuted">#4C566A</Color>
                    <Color x:Key="TextOnAccent">#FFFFFF</Color>
                    <Color x:Key="SeparatorColor">#4C566A</Color>
                    <Color x:Key="BadgeBg">#CC2E3440</Color>
                    <Color x:Key="BadgeText">#D8DEE9</Color>
                    <Color x:Key="DangerColor">#BF616A</Color>
                    <Color x:Key="DangerHoverColor">#AD535C</Color>
