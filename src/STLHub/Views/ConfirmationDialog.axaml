<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STLHub.Views.ConfirmationDialog"
        Title="Confirmação"
        Width="420" MinHeight="180"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DetailsBg}">

    <Window.Styles>
        <Style Selector="PathIcon#WarningIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="PathIcon#WarningIcon.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon x:Name="WarningIcon" Data="{StaticResource IconWarning}" Width="26" Height="26"
                          VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelButton"
                    Content="Cancelar"
                    MinWidth="90"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <!-- "danger" or "primary" is added in code from the request. -->
            <Button x:Name="ConfirmButton"
                    Content="Confirmar"
                    MinWidth="90"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
