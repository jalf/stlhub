<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STLHub.Views.ImportProgressDialog"
        Title="Importando pasta"
        Width="480" MinHeight="200"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DetailsBg}">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="24">
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Text="Importando pasta..." Margin="0,0,0,12"/>

        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="6" Minimum="0" Maximum="100"
                     IsIndeterminate="True" CornerRadius="3"
                     Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextTrimming="CharacterEllipsis" Text="Preparando..."/>

        <TextBlock x:Name="CountText" Grid.Row="3" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="0 objetos · 0 anexos"/>

        <Button x:Name="CancelButton" Grid.Row="4"
                Content="Cancelar"
                HorizontalAlignment="Right"
                MinWidth="100"
                Margin="0,20,0,0"
                IsCancel="True"
                Click="Cancel_Click"/>
    </Grid>
</Window>
