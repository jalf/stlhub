<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STLHub.ViewModels"
        xmlns:models="using:STLHub.Models"
        xmlns:conv="using:STLHub.Converters"
        xmlns:aconv="using:Avalonia.Controls.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="STLHub.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWindowRoot"
        Icon="/Assets/avalonia-logo.ico"
        Title="STLHub"
        DragDrop.AllowDrop="True">

    <Window.Resources>
        <conv:LocalImagePathConverter x:Key="LocalImagePathConverter"/>
        <conv:FileTypeIconConverter x:Key="FileTypeIconConverter"/>

        <!-- Icon Geometries -->
        <StreamGeometry x:Key="FolderOpenIcon">M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V8a2 2 0 00-2-2h-4l-2-2H4z</StreamGeometry>
        <!-- PathIcon scales its geometry to fill the icon box, so these must differ in cell
             count (3x3 / 2x2 / 1) rather than cell size, and share the same 16x16 bounds. -->
        <StreamGeometry x:Key="GridSmallIcon">M0 0h4v4H0zM6 0h4v4H6zM12 0h4v4H12zM0 6h4v4H0zM6 6h4v4H6zM12 6h4v4H12zM0 12h4v4H0zM6 12h4v4H6zM12 12h4v4H12z</StreamGeometry>
        <StreamGeometry x:Key="GridMediumIcon">M0 0h7v7H0zM9 0h7v7H9zM0 9h7v7H0zM9 9h7v7H9z</StreamGeometry>
        <StreamGeometry x:Key="GridLargeIcon">M0 0h16v16H0z</StreamGeometry>
        <StreamGeometry x:Key="SearchIcon">M7 1a6 6 0 014.75 9.67l3.79 3.8-1.06 1.06-3.8-3.79A6 6 0 117 1zm0 1.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9z</StreamGeometry>
        <StreamGeometry x:Key="TagIcon">M1 1h6.6L15 8.4 8.4 15 1 7.6V1zm3.25 2a1.25 1.25 0 100 2.5 1.25 1.25 0 000-2.5z</StreamGeometry>
        <!-- Stroked, not filled: use with Path Stroke=..., never with PathIcon. -->
        <StreamGeometry x:Key="CloseGlyph">M3,3 L9,9 M3,9 L9,3</StreamGeometry>

        <!-- Template for full-width sidebar rows that are real, focusable buttons. Colors and
             states live in the "row" button variant in App.axaml. -->
        <ControlTheme x:Key="SidebarRowButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          Margin="-2"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Icon toggle for the view-size group: the checked option gets a fill, so state
             never rests on opacity alone, and screen readers see a radio group. -->
        <ControlTheme x:Key="ViewSizeToggle" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="Transparent" BorderThickness="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{DynamicResource ToolbarBtnHoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Name="MainGrid" ColumnDefinitions="250, Auto, *, 300" RowDefinitions="Auto, *, Auto">

        <!-- ═══════════ TOOLBAR ═══════════ -->
        <Border Grid.ColumnSpan="4" Background="{DynamicResource ToolbarBg}" Padding="8,6"
                BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Repository -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Command="{Binding OpenRepositoryCommand}"
                            FontSize="12"
                            ToolTip.Tip="Abrir ou criar repositório">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- PathIcon does not inherit the label color; take the button's. -->
                            <PathIcon Data="{StaticResource FolderOpenIcon}" Width="14" Height="14"
                                      Foreground="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="Abrir" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding CurrentRepositoryName}" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"
                               ToolTip.Tip="{Binding CurrentRepositoryName}"/>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                    <Grid Width="380" Height="38">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Buscar objetos..."
                                 AutomationProperties.Name="Buscar objetos"
                                 KeyDown="SearchBox_KeyDown"
                                 CornerRadius="16" Padding="14,7,38,7"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                        <Button Classes="ghost" Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchText}"
                                Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="Limpar busca"
                                ToolTip.Tip="Limpar busca (Esc)">
                            <Viewbox Stretch="Uniform" Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,6 L18,18 M6,18 L18,6"
                                          Stroke="{DynamicResource TextSecondary}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <!-- Sort ComboBox -->
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberBinding="{Binding Label}"
                              Height="32" MinWidth="160" Padding="8,4"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Ordenar"/>

                    <Border Width="1" Height="18" Background="{DynamicResource SeparatorColor}" Margin="6,0"/>

                    <!-- View Size Toggles -->
                    <RadioButton Theme="{StaticResource ViewSizeToggle}" GroupName="ViewSize"
                                 IsChecked="{Binding IsSmallView}"
                                 AutomationProperties.Name="Ícones pequenos"
                                 ToolTip.Tip="Ícones pequenos">
                        <PathIcon Data="{StaticResource GridSmallIcon}" Width="14" Height="14"/>
                    </RadioButton>
                    <RadioButton Theme="{StaticResource ViewSizeToggle}" GroupName="ViewSize"
                                 IsChecked="{Binding IsMediumView}"
                                 AutomationProperties.Name="Ícones médios"
                                 ToolTip.Tip="Ícones médios">
                        <PathIcon Data="{StaticResource GridMediumIcon}" Width="14" Height="14"/>
                    </RadioButton>
                    <RadioButton Theme="{StaticResource ViewSizeToggle}" GroupName="ViewSize"
                                 IsChecked="{Binding IsLargeView}"
                                 AutomationProperties.Name="Ícones grandes"
                                 ToolTip.Tip="Ícones grandes">
                        <PathIcon Data="{StaticResource GridLargeIcon}" Width="14" Height="14"/>
                    </RadioButton>

                    <Border Width="1" Height="18" Background="{DynamicResource SeparatorColor}" Margin="6,0"/>

                    <!-- Include Sub-categories Toggle -->
                    <CheckBox IsChecked="{Binding IncludeSubcategories, Mode=TwoWay}"
                              Height="32" Padding="8,0,0,0"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip.Tip="Listar também os objetos das subpastas da pasta selecionada">
                        <TextBlock Text="Incluir subpastas" FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </CheckBox>

                    <Border Width="1" Height="18" Background="{DynamicResource SeparatorColor}" Margin="6,0"/>

                    <!-- Theme Selector -->
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedThemeOption}"
                              DisplayMemberBinding="{Binding Label}"
                              Height="32" MinWidth="130" Padding="8,0"
                              VerticalContentAlignment="Center"
                              CornerRadius="6"
                              ToolTip.Tip="Selecionar tema"/>

                    <Border Width="1" Height="18" Background="{DynamicResource SeparatorColor}" Margin="6,0"/>

                    <!-- About -->
                    <Button Classes="ghost" Click="About_Click"
                            Height="32" Width="32"
                            AutomationProperties.Name="Sobre o STLHub"
                            ToolTip.Tip="Sobre o STLHub">
                        <PathIcon Data="M8 1a7 7 0 100 14A7 7 0 008 1zm0 2.5a1.25 1.25 0 110 2.5 1.25 1.25 0 010-2.5zM6.75 7.5h2.5v5h-2.5v-5z"
                                  Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBg}"
                MinWidth="180" MaxWidth="500">
            <Grid RowDefinitions="Auto, Auto, *">
                <!-- "All Objects": clears both filters; also the drop target for moving a
                     category back to the root. -->
                <Button Grid.Row="0" Theme="{StaticResource SidebarRowButton}" Classes="row"
                        Command="{Binding ShowAllObjectsCommand}"
                        Classes.active="{Binding IsAllObjectsSelected}"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="RootCategory_DragOver"
                        DragDrop.Drop="RootCategory_Drop">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Todos os Objetos" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tags Section -->
                <Border Grid.Row="1" IsVisible="{Binding AllTags.Count}">
                    <StackPanel>
                        <Border Background="{DynamicResource SidebarHeaderBg}" Padding="14,8">
                            <TextBlock Text="TAGS" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" LetterSpacing="1.5"/>
                        </Border>
                        <ListBox ItemsSource="{Binding AllTags}"
                                 SelectedItem="{Binding SelectedTag}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="200"
                                 AutomationProperties.Name="Tags"
                                 KeyDown="TagList_KeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <!-- The delete button appears only for the row in hand, so the
                                     sidebar is not a column of red marks. -->
                                <Style Selector="ListBoxItem Button.reveal">
                                    <Setter Property="Opacity" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Button.reveal, ListBoxItem:selected Button.reveal, ListBoxItem:focus-within Button.reveal">
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,6" Background="Transparent">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Excluir tag…"
                                                          Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).DeleteTagGlobalCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🏷" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Grid.Column="2" Classes="ghost reveal"
                                                    Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).DeleteTagGlobalCommand}"
                                                    CommandParameter="{Binding}"
                                                    Width="20" Height="20" CornerRadius="10"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Excluir a tag {0}'}"
                                                    ToolTip.Tip="Excluir tag de todos os objetos">
                                                <Path Data="{StaticResource CloseGlyph}" Width="12" Height="12"
                                                      Stroke="{DynamicResource DangerColor}" StrokeThickness="1.5"
                                                      StrokeLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Category Tree -->
                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarHeaderBg}" Padding="14,8">
                        <TextBlock Text="CATEGORIAS" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" LetterSpacing="1.5"/>
                    </Border>
                    <Button DockPanel.Dock="Top" Theme="{StaticResource SidebarRowButton}" Classes="row"
                            Padding="14,8"
                            Foreground="{DynamicResource TextSecondary}"
                            Command="{Binding AddRootCategoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="+" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Nova Categoria" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TreeView Name="CategoryTree"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              AutomationProperties.Name="Categorias"
                              KeyDown="CategoryTree_KeyDown"
                              Background="{DynamicResource SidebarBg}"
                              BorderThickness="0"
                              Padding="0"
                              Margin="0,0,0,0">
                        <TreeView.Template>
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  AllowAutoHide="True"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalAlignment="Stretch" />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </TreeView.Template>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:CategoryNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemContainerTheme>
                            <ControlTheme TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TreeViewItemForeground}"/>
                                <Setter Property="MinHeight" Value="20"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Name="PART_LayoutRoot"
                                                    Classes="TreeViewItemLayoutRoot"
                                                    Focusable="True"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    MinHeight="{TemplateBinding MinHeight}"
                                                    HorizontalAlignment="Stretch"
                                                    TemplatedControl.IsTemplateFocusTarget="True">
                                                <Grid Name="PART_Header" ColumnDefinitions="Auto, *">
                                                    <Grid.Margin>
                                                        <MultiBinding Converter="{x:Static aconv:TreeViewItemIndentConverter.Instance}">
                                                            <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                            <DynamicResource ResourceKey="TreeViewItemIndent"/>
                                                        </MultiBinding>
                                                    </Grid.Margin>
                                                       <Panel Name="PART_ExpandCollapseChevronContainer"
                                                           Margin="8,0,2,0">
                                                        <ToggleButton Name="PART_ExpandCollapseChevron"
                                                                      Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                                                      Focusable="False"
                                                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"/>
                                                    </Panel>
                                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                                      Grid.Column="1"
                                                                      Focusable="False"
                                                                      Background="Transparent"
                                                                      Content="{TemplateBinding Header}"
                                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter Name="PART_ItemsPresenter"
                                                            Grid.Row="1"
                                                            IsVisible="{TemplateBinding IsExpanded}"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter>
                                <!-- Hover -->
                                <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                                </Style>
                                <!-- Selected -->
                                <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/>
                                </Style>
                                <Style Selector="^:selected:focus /template/ Border#PART_LayoutRoot">
                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBg}"/>
                                </Style>
                                <!-- Empty chevron hidden -->
                                <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                                    <Setter Property="IsVisible" Value="False"/>
                                </Style>
                                <Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                                    <Setter Property="Width" Value="{DynamicResource TreeViewItemExpandCollapseChevronSize}"/>
                                </Style>
                            </ControlTheme>
                        </TreeView.ItemContainerTheme>
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="vm:CategoryNode" ItemsSource="{Binding Children}">
                                    <Grid Name="CategoryItemRoot"
                                        MinHeight="18"
                                          Background="Transparent"
                                          DragDrop.AllowDrop="True"
                                          DragDrop.Drop="Category_Drop"
                                          DragDrop.DragOver="Category_DragOver"
                                          PointerPressed="Category_PointerPressed"
                                          PointerMoved="Category_PointerMoved">
                                        <!-- Display Mode -->
                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="1,0,1,0"
                                                    IsVisible="{Binding !IsEditing}"
                                                    DoubleTapped="CategoryLabel_DoubleTapped">
                                            <TextBlock Text="📂" FontSize="13" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsExpanded}"/>
                                            <TextBlock Text="📁" FontSize="13" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsExpanded}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Edit Mode -->
                                        <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"
                                                 Background="{DynamicResource EditBg}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 BorderThickness="1"
                                                 BorderBrush="{DynamicResource EditBorderColor}"
                                                 FontSize="13" Padding="4,2" Margin="4,2"
                                                 KeyDown="CategoryTextBox_KeyDown"
                                                 LostFocus="CategoryTextBox_LostFocus"
                                                 Name="CategoryRenameBox"/>

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="📁 Nova Subcategoria"
                                                          Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).AddSubCategoryCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="✏ Renomear" InputGesture="F2"
                                                          Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RenameCategoryCommand}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="🗑 Excluir…" InputGesture="Delete"
                                                          Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).DeleteCategoryCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══════════ GRID SPLITTER ═══════════ -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" ResizeDirection="Columns"
                      Background="{DynamicResource SeparatorColor}" Cursor="SizeWestEast"/>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource ContentBg}">
            <Grid RowDefinitions="Auto, *">
                <!-- Active filters: category and tag combine; each chip removes its own filter. -->
                <WrapPanel Grid.Row="0" Margin="20,14,20,0"
                           IsVisible="{Binding HasActiveFilters}">
                    <WrapPanel.Styles>
                        <Style Selector="Border.filter-chip">
                            <Setter Property="Background" Value="{DynamicResource TagBg}"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Padding" Value="10,4,4,4"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </Style>
                        <Style Selector="Button.chip-remove">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </WrapPanel.Styles>
                    <Border Classes="filter-chip" IsVisible="{Binding ActiveCategoryLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource FolderOpenIcon}" Width="12" Height="12"
                                      Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ActiveCategoryLabel}" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="360" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Button Classes="ghost chip-remove" Command="{Binding ClearCategoryFilterCommand}"
                                    AutomationProperties.Name="Remover filtro de categoria"
                                    ToolTip.Tip="Remover filtro de categoria">
                                <Path Data="{StaticResource CloseGlyph}" Width="12" Height="12"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                      StrokeLineCap="Round"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Classes="filter-chip" IsVisible="{Binding ActiveTagLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource TagIcon}" Width="12" Height="12"
                                      Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ActiveTagLabel}" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Button Classes="ghost chip-remove" Command="{Binding ClearTagFilterCommand}"
                                    AutomationProperties.Name="Remover filtro de tag"
                                    ToolTip.Tip="Remover filtro de tag">
                                <Path Data="{StaticResource CloseGlyph}" Width="12" Height="12"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                      StrokeLineCap="Round"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </WrapPanel>

            <Panel Grid.Row="1">
                <!-- Watermark: decoration behind the cards, removed when a message takes the centre. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0.08" IsHitTestVisible="False" Spacing="0"
                            IsVisible="{Binding !IsEmptyStateVisible}">
                    <Image Source="/Assets/watermark.png" Width="220" Height="220"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </StackPanel>

                <!-- Empty library -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding IsLibraryEmpty}"
                            IsHitTestVisible="False"
                            MaxWidth="320"
                            Spacing="12">
                    <PathIcon Data="{StaticResource FolderOpenIcon}"
                              Width="40" Height="40"
                              Foreground="{DynamicResource TextSecondary}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Biblioteca vazia"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Arraste uma pasta aqui ou use Abrir para criar uma biblioteca"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Nothing matches the search and/or filters; the library itself is not empty. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding IsNoResults}"
                            MaxWidth="380"
                            Spacing="12">
                    <PathIcon Data="{StaticResource SearchIcon}"
                              Width="32" Height="32"
                              Foreground="{DynamicResource TextSecondary}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding NoResultsTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding NoResultsMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Content="Limpar busca"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchText}"/>
                        <Button Content="Mostrar todos os objetos"
                                Command="{Binding ShowAllObjectsCommand}"
                                IsVisible="{Binding HasActiveFilters}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Slow query: shown only after a short delay, so quick searches never flicker. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding IsLoadingPlaceholder}"
                            IsHitTestVisible="False"
                            Width="200" Spacing="12">
                    <TextBlock Text="Carregando objetos..."
                               FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="3"
                                 Foreground="{DynamicResource AccentColor}"/>
                </StackPanel>

                <!-- Object Cards (hidden behind a placeholder so its transparent surface
                     cannot swallow clicks meant for the placeholder's buttons) -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding !IsEmptyStateVisible}">
                <Border Padding="16">
                <ListBox x:Name="ObjectList"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedObject}"
                         AutomationProperties.Name="Objetos"
                         KeyDown="ObjectList_KeyDown"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Panel>
                                        <ContentPresenter Name="PART_ContentPresenter"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        <Border Name="SelectionRing"
                                                CornerRadius="12"
                                                BorderThickness="0"
                                                BorderBrush="{DynamicResource AccentColor}"
                                                IsHitTestVisible="False"
                                                Margin="4"/>
                                    </Panel>
                                </ControlTemplate>
                            </Setter>
                            <Style Selector="^:selected /template/ Border#SelectionRing">
                                <Setter Property="BorderThickness" Value="2"/>
                            </Style>
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBg}" Margin="4" CornerRadius="12"
                                    Width="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).CardWidth}"
                                    Height="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).CardHeight}"
                                    BoxShadow="0 2 12 0 #28000000"
                                    DoubleTapped="Object3D_DoubleTapped"
                                    PointerPressed="Object3D_PointerPressed"
                                    PointerMoved="Object3D_PointerMoved">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🔄 Refazer Thumbnail"
                                                  Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RegenerateThumbnailCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="🗑 Excluir Objeto…" InputGesture="Delete"
                                                  Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).DeleteObjectCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid RowDefinitions="*, Auto">
                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                            Background="{DynamicResource CardThumbnailBg}"
                                            Height="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).ThumbnailHeight}"
                                            PointerEntered="ThumbnailBorder_PointerEntered"
                                            PointerExited="ThumbnailBorder_PointerExited">
                                        <Panel>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource LocalImagePathConverter}}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource BadgeBg}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Padding="6,2" CornerRadius="6,0,0,0">
                                                <TextBlock Text="{Binding FileType}" FontSize="10"
                                                           Foreground="{DynamicResource BadgeText}" FontWeight="Bold"/>
                                            </Border>
                                        </Panel>
                                    </Border>
                                    <!-- Name -->
                                    <StackPanel Grid.Row="1" Margin="10,6,10,8">
                                        <StackPanel Spacing="4">
                                            <!-- Categoria como badge alinhada à direita -->
                                            <Border Background="{DynamicResource TagBg}"
                                                    Padding="8,2" CornerRadius="8" HorizontalAlignment="Right"
                                                    IsVisible="{Binding CategoryName, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </Border>
                                            <!-- Nome do objeto -->
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Name}"
                                                FontSize="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).CardFontSize}"
                                                Text="{Binding Name}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Border>
            </ScrollViewer>
            </Panel>
            </Grid>
        </Border>

        <!-- ═══════════ DETAILS PANEL ═══════════ -->
        <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource DetailsBg}" Padding="20"
                BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="1,0,0,0"
                IsVisible="{Binding SelectedObject, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="Detalhes" FontWeight="Bold" FontSize="18"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" Margin="0,0,0,15" Padding="0,0,10,0">
                    <StackPanel Spacing="14">
                        <!-- Thumbnail and path. Templated so these fields are not bound through a
                             null SelectedObject while the panel is hidden. -->
                        <ContentControl Content="{Binding SelectedObject}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="models:Object3D">
                                    <StackPanel Spacing="14">
                                        <Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource CardThumbnailBg}"
                                                Height="160" Cursor="Hand" DoubleTapped="DetailThumbnail_DoubleTapped"
                                                BoxShadow="0 2 10 0 #28000000">
                                            <Panel>
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource LocalImagePathConverter}}"
                                                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource BadgeBg}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Padding="8,3" CornerRadius="6,0,0,0">
                                                    <TextBlock Text="{Binding FileType}" FontSize="11"
                                                               Foreground="{DynamicResource BadgeText}" FontWeight="Bold"/>
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <TextBlock Text="Caminho" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                                   FontWeight="SemiBold" Margin="0,0,0,-8"/>
                                        <TextBlock Text="{Binding RelativeFilePath}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <TextBlock Text="Nome" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,6,0,-8"/>
                        <StackPanel Spacing="4">
                            <TextBox Text="{Binding EditedName, Mode=TwoWay}" CornerRadius="6"
                                     MaxLength="200"
                                     AutomationProperties.Name="Nome"
                                     Classes.invalid="{Binding IsNameInvalid}">
                                <TextBox.Styles>
                                    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}"/>
                                    </Style>
                                </TextBox.Styles>
                            </TextBox>
                            <TextBlock Text="O nome não pode ficar vazio; o nome anterior será mantido."
                                       IsVisible="{Binding IsNameInvalid}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <TextBlock Text="Descrição" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,2,0,-8"/>
                        <TextBox Text="{Binding EditedDescription, Mode=TwoWay}"
                                 AutomationProperties.Name="Descrição"
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap" CornerRadius="6"/>

                        <ContentControl Content="{Binding SelectedObject}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="models:Object3D">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Data de criação" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                                   FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <TextBlock Text="Tags" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,2,0,-8"/>
                        <ItemsControl ItemsSource="{Binding ObjectTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TagBg}" CornerRadius="12"
                                            Padding="10,4" Margin="0,0,5,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Classes="ghost"
                                                    Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoveTagCommand}"
                                                    CommandParameter="{Binding}"
                                                    Width="18" Height="18" CornerRadius="9"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Remover a tag {0} deste objeto'}"
                                                    ToolTip.Tip="Remover deste objeto">
                                                <Path Data="{StaticResource CloseGlyph}" Width="12" Height="12"
                                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                                      StrokeLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding NewTagName, Mode=TwoWay}" PlaceholderText="Nova tag..."
                                     MaxLength="50"
                                     AutomationProperties.Name="Nova tag"
                                     Width="130" FontSize="12" CornerRadius="6" KeyDown="NewTagTextBox_KeyDown"/>
                            <Button Content="+" Command="{Binding AddTagCommand}"
                                    AutomationProperties.Name="Adicionar tag"
                                    ToolTip.Tip="Adicionar tag (Enter)"
                                    Width="32" Height="32" FontSize="16" Padding="0"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource SeparatorColor}" Margin="0,6"/>

                        <TextBlock Text="Arquivos Associados" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <ListBox ItemsSource="{Binding Attachments}" Background="Transparent"
                                 BorderThickness="0" MaxHeight="150"
                                 AutomationProperties.Name="Arquivos associados"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem Button.reveal">
                                    <Setter Property="Opacity" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Button.reveal, ListBoxItem:selected Button.reveal, ListBoxItem:focus-within Button.reveal">
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="90" Height="100" Margin="4" DoubleTapped="Attachment_DoubleTapped" Background="Transparent">
                                        <Panel>
                                            <Border Background="{DynamicResource CardThumbnailBg}" CornerRadius="8" ClipToBounds="True">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource FileTypeIconConverter}}" FontSize="28"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="8" ClipToBounds="True">
                                                <Image Source="{Binding FilePath, Converter={StaticResource LocalImagePathConverter}}" Stretch="UniformToFill"/>
                                            </Border>
                                        </Panel>
                                        <Border Background="{DynamicResource BadgeBg}" VerticalAlignment="Bottom"
                                                Padding="5" CornerRadius="0,0,8,8">
                                            <TextBlock Text="{Binding FilePath}" FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource BadgeText}"
                                                       ToolTip.Tip="{Binding FilePath}"/>
                                        </Border>
                                        <Button Classes="overlay reveal"
                                                Command="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                Width="22" Height="22"
                                                CornerRadius="11"
                                                AutomationProperties.Name="{Binding Type, StringFormat='Remover anexo {0}'}"
                                                ToolTip.Tip="Remover anexo">
                                            <!-- Stroke follows the button's foreground, so it flips with the hover fill. -->
                                            <Path Data="{StaticResource CloseGlyph}" Width="12" Height="12"
                                                  Stroke="{Binding $parent[ContentPresenter].Foreground}" StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="Anexar Arquivo..." Click="AttachFile_Click"
                                HorizontalAlignment="Stretch"/>

                        <!-- Read-only project info extracted from the selected .3mf file -->
                        <StackPanel IsVisible="{Binding IsProjectInfo3mfVisible}" Spacing="6" Margin="0,8,0,0">
                            <Border Height="1" Background="{DynamicResource SeparatorColor}" Margin="0,6"/>
                            <TextBlock Text="Informações 3MF" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <ProgressBar IsVisible="{Binding IsProjectInfo3mfLoading}"
                                         IsIndeterminate="True" Height="3" Margin="0,2,0,4"/>

                            <!-- The template is only realized once Content is non-null, so no field
                                 binding is ever resolved through a null ProjectInfo3mf. -->
                            <ContentControl Content="{Binding ProjectInfo3mf}"
                                            IsVisible="{Binding !IsProjectInfo3mfLoading}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="models:ThreeMfProjectInfo">
                                        <StackPanel Spacing="6">
                                            <StackPanel IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="Título" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding Designer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="Designer" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Designer}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>

                                            <!-- Plain-text descriptions read fine in place. -->
                                            <StackPanel IsVisible="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).HasPlainDescription3mf}">
                                                <TextBlock Text="Descrição" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                           MaxLines="8" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Description}"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>

                                            <!-- HTML descriptions would show as raw markup here, so they open in a viewer. -->
                                            <StackPanel IsVisible="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).HasRichDescription3mf}">
                                                <TextBlock Text="Descrição" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                <Button Content="Ver descrição do projeto" Click="ViewDescription_Click"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,4,0,0" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding CreationDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="Data de Criação" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding CreationDate}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>

                                            <!-- Print profile fields, present only for slicer-produced files -->
                                            <StackPanel IsVisible="{Binding HasAnyProfileData}" Spacing="6" Margin="0,6,0,0">
                                                <TextBlock Text="Perfil de Impressão" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <StackPanel IsVisible="{Binding ProfileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="Perfil" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding ProfileName}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding LayerHeight, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="Altura de Camada" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding LayerHeight}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding WallCount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="Paredes" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding WallCount}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding InfillPercent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="Preenchimento" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding InfillPercent}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <StackPanel IsVisible="{Binding ProfileAuthor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="Autor do Perfil" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding ProfileAuthor}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 10px right margin matches the scroll area's padding, so the button ends where
                     the fields above it end. -->
                <Button Grid.Row="2" Classes="primary" Content="Salvar Alterações" Command="{Binding SaveMetadataCommand}"
                        ToolTip.Tip="As alterações também são salvas ao selecionar outro objeto"
                        HorizontalAlignment="Stretch" Margin="0,0,10,0"
                        MinHeight="36" FontSize="14"/>
            </Grid>
        </Border>

        <!-- Details panel watermark (when no object is selected) -->
        <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource DetailsBg}"
                BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="1,0,0,0"
                IsVisible="{Binding SelectedObject, Converter={x:Static ObjectConverters.IsNull}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0.08" IsHitTestVisible="False">
                <Image Source="/Assets/watermark.png" Width="140" Height="140"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ STATUS BAR ═══════════ -->
        <Border Grid.Row="2" Grid.ColumnSpan="4" Background="{DynamicResource ToolbarBg}"
                BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="0,1,0,0"
                Padding="12,4" Height="26">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Progress indicator -->
                <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="80" Height="3"
                             Margin="0,0,10,0" VerticalAlignment="Center"
                             IsVisible="{Binding IsActivityVisible}"
                             Foreground="{DynamicResource AccentColor}"/>
                <!-- Status / Hint text -->
                <TextBlock Grid.Column="1" Name="StatusBarText"
                           Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <!-- Item count -->
                <TextBlock Grid.Column="2" FontSize="11"
                           Text="{Binding ItemCountText}"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
