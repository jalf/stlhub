<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STLHub.Views.WarningDialog"
        Title="Aviso"
        Width="420" MinHeight="180"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DetailsBg}">

    <Grid RowDefinitions="*, Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon x:Name="WarningIcon" Data="{StaticResource IconWarning}" Width="26" Height="26"
                          Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Button x:Name="OkButton"
                Grid.Row="1"
                Content="OK"
                IsDefault="True"
                IsCancel="True"
                Classes="primary"
                HorizontalAlignment="Right"
                MinWidth="90"
                Click="Ok_Click"/>
    </Grid>
</Window>
